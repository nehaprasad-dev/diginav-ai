# DigiNav AI – backend environment variables
# Copy this file to `.env` and fill in real values.

# Groq LLM API key
GROQ_API_KEY=

# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/diginav

# Admin page secret token
ADMIN_TOKEN=changeme

# Comma-separated allowed CORS origins
CORS_ORIGINS=["http://localhost:3000"]

# Set to true for verbose SQL logging and /docs endpoint
DEBUG=false
