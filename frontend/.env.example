# DigiNav AI – frontend environment variables
# Copy this file to `.env.local` and fill in real values.

# Base URL of the FastAPI backend (no trailing slash).
# Example: http://localhost:8000  (dev)  |  https://api.diginav.ai  (prod)
BACKEND_URL=http://localhost:8000

# Optional: also exposed to the browser for client-side fetches.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8000

# Groq API key used for LLM streaming. In the MVP the frontend does NOT
# call Groq directly — the backend holds this key. It is listed here so
# contributors know the full set of secrets the stack uses.
GROQ_API_KEY=
